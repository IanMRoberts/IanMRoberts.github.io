---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Sections
import ProjectGallery from "@/components/landing/ProjectGallery.astro";
// Content
import { projects } from "@/data/projects";

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/projects/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);
const videoFiles = import.meta.glob<{ default: string }>(
  "/src/images/projects/*.{mp4,webm,mov}",
  { eager: true },
);
---

<section class="scroll-mt-32" id="projects">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex flex-col gap-12">
      {
        projects.map((project) => {
          const galleryMedia = project.media
            .map((item) => {
              if (item.type === "video") {
                const src = videoFiles[`/src/images/projects/${item.file}`];
                return (
                  src && {
                    type: "video" as const,
                    src: src.default,
                    alt: item.alt,
                    width: item.width ?? 16,
                    height: item.height ?? 9,
                  }
                );
              }
              const file = imageFiles[`/src/images/projects/${item.file}`];
              return file && { type: "image" as const, src: file.default, alt: item.alt };
            })
            .filter((item) => item !== undefined);
          return (
            <article class="py-12 border-t border-base-200 dark:border-base-800">
              <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
                <Text
                  tag="p"
                  variant="textXS"
                  class="text-base-600 dark:text-base-300 uppercase"
                >
                  {project.year}
                </Text>
                <Text
                  tag="h3"
                  variant="displaySM"
                  class="text-base-900 dark:text-white leading-tight font-semibold "
                >
                  {project.title}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-600 dark:text-base-300"
                >
                  {project.description}
                </Text>
              </div>
              {galleryMedia.length > 0 && (
                <ProjectGallery media={galleryMedia} title={project.title} />
              )}
            </article>
          );
        })
      }
    </div>
  </Wrapper>
</section>
