---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Sections
import ProjectGallery from "@/components/landing/ProjectGallery.astro";
// Content
import { projects } from "@/data/projects";

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/projects/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);
---

<section class="scroll-mt-32" id="projects">
  <Wrapper variant="standard" class="py-8 lg:py-16">
    <div class="flex flex-col gap-8">
      {
        projects.map((project) => {
          const galleryImages = project.images
            .map((image) => {
              const file = imageFiles[`/src/images/projects/${image.file}`];
              return file && { src: file.default, alt: image.alt };
            })
            .filter((image) => image !== undefined);
          return (
            <article class="py-6 border-t border-base-200 dark:border-base-800">
              <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
                <Text
                  tag="p"
                  variant="textXS"
                  class="text-base-600 dark:text-base-300 uppercase"
                >
                  {project.year}
                </Text>
                <Text
                  tag="h3"
                  variant="displaySM"
                  class="text-base-900 dark:text-white leading-tight font-semibold "
                >
                  {project.title}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-600 dark:text-base-300"
                >
                  {project.description}
                </Text>
              </div>
              {galleryImages.length > 0 && (
                <ProjectGallery images={galleryImages} title={project.title} />
              )}
            </article>
          );
        })
      }
    </div>
  </Wrapper>
</section>
