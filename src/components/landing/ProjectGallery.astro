---
import { Image } from "astro:assets";

interface ImageSlide {
	type: "image";
	src: ImageMetadata;
	alt: string;
}

interface VideoSlide {
	type: "video";
	src: string;
	alt: string;
	width: number;
	height: number;
}

type Slide = ImageSlide | VideoSlide;

interface Props {
	media: Slide[];
	title: string;
}

const { media, title } = Astro.props;

// The gallery's height tracks the first item's aspect ratio; other slides
// are letterboxed (never cropped) via object-contain if their ratio differs.
const first = media[0];
const firstDimensions =
	first.type === "image"
		? { width: first.src.width, height: first.src.height }
		: { width: first.width, height: first.height };
const containerRatio = `${firstDimensions.width} / ${firstDimensions.height}`;
const maxWidth = 1600;

const slides = media.map((item) => {
	if (item.type === "video") return item;
	const scale = Math.min(1, maxWidth / item.src.width);
	return {
		...item,
		width: Math.round(item.src.width * scale),
		height: Math.round(item.src.height * scale),
	};
});
---

<div class="gallery relative mt-12" data-gallery style={`aspect-ratio: ${containerRatio}`}>
	<div
		class="gallery-track flex h-full overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide rounded-4xl"
		data-track
	>
		{
			slides.map((item, index) =>
				item.type === "video" ? (
					<div class="w-full h-full shrink-0 snap-start" data-slide>
						<video
							src={item.src}
							controls
							muted
							playsinline
							preload="metadata"
							aria-label={item.alt}
							class="size-full object-contain object-center"
						/>
					</div>
				) : (
					<div class="w-full h-full shrink-0 snap-start" data-slide>
						<Image
							width={item.width}
							height={item.height}
							src={item.src}
							alt={item.alt}
							loading={index === 0 ? "eager" : "lazy"}
							decoding="async"
							class="size-full object-contain object-center"
						/>
					</div>
				),
			)
		}
	</div>

	{
		media.length > 1 && (
			<>
				<button
					type="button"
					class="absolute top-1/2 left-4 -translate-y-1/2 flex items-center justify-center size-10 rounded-full bg-base-950/60 text-white hover:bg-base-950/80 transition-colors"
					aria-label={`Previous image in ${title}`}
					data-prev
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-5"
					>
						<path d="m15 18-6-6 6-6" />
					</svg>
				</button>
				<button
					type="button"
					class="absolute top-1/2 right-4 -translate-y-1/2 flex items-center justify-center size-10 rounded-full bg-base-950/60 text-white hover:bg-base-950/80 transition-colors"
					aria-label={`Next image in ${title}`}
					data-next
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-5"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				</button>
				<div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
					{media.map((_, index) => (
						<button
							type="button"
							class="size-2 rounded-full bg-white/50 data-[active=true]:bg-white transition-colors"
							aria-label={`Go to item ${index + 1} of ${media.length} in ${title}`}
							data-dot
							data-index={index}
						/>
					))}
				</div>
			</>
		)
	}
</div>

<script>
	function initGalleries() {
		document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
			if (gallery.dataset.initialized) return;
			gallery.dataset.initialized = "true";

			const track = gallery.querySelector<HTMLElement>("[data-track]");
			const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-slide]"));
			const prevButton = gallery.querySelector<HTMLButtonElement>("[data-prev]");
			const nextButton = gallery.querySelector<HTMLButtonElement>("[data-next]");
			const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-dot]"));
			if (!track || slides.length === 0) return;

			const setActiveDot = (index: number) => {
				dots.forEach((dot, dotIndex) => {
					dot.dataset.active = String(dotIndex === index);
				});
			};

			const scrollToIndex = (index: number, behavior: ScrollBehavior = "smooth") => {
				const slide = slides[index];
				if (slide) track.scrollTo({ left: slide.offsetLeft, behavior });
			};

			const getCurrentIndex = () =>
				slides.findIndex(
					(slide) => Math.abs(slide.offsetLeft - track.scrollLeft) < track.clientWidth / 2,
				);

			const autoplayMs = 5000;
			let autoplayId: number | undefined;

			const stopAutoplay = () => {
				if (autoplayId !== undefined) {
					window.clearInterval(autoplayId);
					autoplayId = undefined;
				}
			};

			const startAutoplay = () => {
				if (slides.length <= 1) return;
				stopAutoplay();
				autoplayId = window.setInterval(() => {
					scrollToIndex((getCurrentIndex() + 1) % slides.length);
				}, autoplayMs);
			};

			prevButton?.addEventListener("click", () => {
				scrollToIndex(Math.max(getCurrentIndex() - 1, 0));
				startAutoplay();
			});

			nextButton?.addEventListener("click", () => {
				scrollToIndex(Math.min(getCurrentIndex() + 1, slides.length - 1));
				startAutoplay();
			});

			dots.forEach((dot, index) => {
				dot.addEventListener("click", () => {
					scrollToIndex(index);
					startAutoplay();
				});
			});

			gallery.addEventListener("mouseenter", stopAutoplay);
			gallery.addEventListener("mouseleave", startAutoplay);
			gallery.querySelectorAll("video").forEach((video) => {
				video.addEventListener("play", stopAutoplay);
				video.addEventListener("pause", startAutoplay);
				video.addEventListener("ended", startAutoplay);
			});

			// Only autoplay while the gallery is on screen; reset to the first
			// slide once it scrolls out of view.
			const visibilityObserver = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						startAutoplay();
					} else {
						stopAutoplay();
						scrollToIndex(0, "instant");
						setActiveDot(0);
						gallery.querySelectorAll("video").forEach((video) => video.pause());
					}
				},
				{ threshold: 0.4 },
			);
			visibilityObserver.observe(gallery);

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							const index = slides.indexOf(entry.target as HTMLElement);
							if (index !== -1) setActiveDot(index);
							const video = entry.target.querySelector("video");
							video?.play().catch(() => {});
						} else {
							entry.target.querySelector("video")?.pause();
						}
					});
				},
				{ root: track, threshold: 0.6 },
			);
			slides.forEach((slide) => observer.observe(slide));

			setActiveDot(0);
		});
	}

	initGalleries();
	document.addEventListener("astro:page-load", initGalleries);
</script>
